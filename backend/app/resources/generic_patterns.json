{
  "_version": "1.0",
  "_note": "'Make it yours' generic-spot detector (CLAUDE.md §9.3). Phrase lists are matched case-insensitively on word boundaries; {lemma} matches every form of that verb. 'prompts' holds the question shown to the student for each pattern ({phrase} = matched text, {subject} = the sentence subject). 'starter' pre-fills the answer box.",
  "prompts": {
    "abstract_claim": {
      "label": "Claim with no example",
      "prompt": "'{phrase}': name one specific case of {subject} that you have seen or read about (lab, internship, project or a source).",
      "starter": "For example, "
    },
    "vague_source": {
      "label": "Unnamed source",
      "prompt": "'{phrase}': which study or source? Add the reference, or say where you learned this.",
      "starter": "For example, "
    },
    "vague_benefit": {
      "label": "Benefit with no figure",
      "prompt": "'{phrase}': by how much? Add a number from your results or from a source you read.",
      "starter": "In our test, "
    },
    "results_no_number": {
      "label": "Result with no number",
      "prompt": "Add the value you measured, with its unit.",
      "starter": "We measured "
    },
    "vague_quantifier": {
      "label": "Vague amount",
      "prompt": "'{phrase}': how many, or which ones? Add the actual number or name them.",
      "starter": "These include "
    },
    "vague_intensifier": {
      "label": "Size with no figure",
      "prompt": "'{phrase}': how big was the change? Add the figure or comparison that shows it.",
      "starter": "It went from "
    },
    "vague_time": {
      "label": "Vague time",
      "prompt": "'{phrase}': when exactly? Add a year, a date or a period.",
      "starter": "Since "
    },
    "conclusion_no_voice": {
      "label": "Conclusion without your view",
      "prompt": "What did you learn, what surprised you, or what would you do differently? Add one sentence in your own words.",
      "starter": "What I learned from this project is that "
    },
    "no_concrete_run": {
      "label": "Nothing concrete",
      "prompt": "These sentences have no names, numbers or parts. Add one concrete detail from your own work: a component, a value or a place.",
      "starter": "In our setup, "
    }
  },
